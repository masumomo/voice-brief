# VoiceBrief Environment Variables Example
# コピーして .env として使用してください
# このファイルは絶対に Git にコミットしないでください！

# Slack Bot Token
# https://api.slack.com/apps でアプリを作成し、Bot Token を取得
VOICE_BRIEF_SLACK_TOKEN="xoxb-your-slack-bot-token-here"

# Notion Integration Token
# https://www.notion.so/my-integrations で Integration を作成し、Secret を取得
VOICE_BRIEF_NOTION_TOKEN="secret_your-notion-token-here"

# GitHub Personal Access Token（オプション）
# https://github.com/settings/tokens で作成
# VOICE_BRIEF_GITHUB_TOKEN="ghp_your-github-token-here"

# Gemini API Key（オプション - Gemini provider使用時のみ）
# https://aistudio.google.com/app/apikey で作成
# 無料枠: 毎分15リクエスト、毎日1500リクエストまで
# GEMINI_API_KEY="your-gemini-api-key-here"

# Google Cloud TTS認証情報（オプション - Google TTS provider使用時のみ）
# https://console.cloud.google.com/ でサービスアカウントキーを作成
# 無料枠: 毎月100万文字まで無料
# GOOGLE_APPLICATION_CREDENTIALS_JSON='{"type":"service_account","project_id":"your-project",...}'

# OpenAI API Key（オプション - OpenAI Summarizer/TTS使用時のみ）
# https://platform.openai.com/api-keys で作成
# Summarizerのコスト目安（gpt-4o-mini）:
#   - Daily: 約$0.001-0.003/回
#   - Weekly: 約$0.003-0.008/回
# OPENAI_API_KEY="sk-your-openai-key-here"
