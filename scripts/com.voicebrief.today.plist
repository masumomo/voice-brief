<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ジョブ識別名 -->
    <key>Label</key>
    <string>com.voicebrief.today</string>

    <!-- 実行するプログラム -->
    <key>ProgramArguments</key>
    <array>
        <!-- REPLACE_WITH_VOICEBRIEF_PATH は install_today.sh で置換される -->
        <string>REPLACE_WITH_VOICEBRIEF_PATH</string>
        <string>run</string>
        <string>--today</string>
    </array>

    <!-- 環境変数（トークン設定） -->
    <key>EnvironmentVariables</key>
    <dict>
        <!-- 実際のトークンは ~/.zshrc や ~/.bashrc で設定すること -->
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- 実行スケジュール: 月〜金曜日 23:00（当日分を夜に取得） -->
    <!-- Weekday: 0=日, 1=月, 2=火, 3=水, 4=木, 5=金, 6=土 -->
    <key>StartCalendarInterval</key>
    <array>
        <!-- 月曜日 23:00 -->
        <dict>
            <key>Weekday</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>23</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- 火曜日 23:00 -->
        <dict>
            <key>Weekday</key>
            <integer>2</integer>
            <key>Hour</key>
            <integer>23</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- 水曜日 23:00 -->
        <dict>
            <key>Weekday</key>
            <integer>3</integer>
            <key>Hour</key>
            <integer>23</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- 木曜日 23:00 -->
        <dict>
            <key>Weekday</key>
            <integer>4</integer>
            <key>Hour</key>
            <integer>23</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- 金曜日 23:00 -->
        <dict>
            <key>Weekday</key>
            <integer>5</integer>
            <key>Hour</key>
            <integer>23</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <!-- 標準出力・標準エラー出力のログファイル -->
    <key>StandardOutPath</key>
    <string>/tmp/voicebrief-today.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/voicebrief-today-error.log</string>

    <!-- システム起動時に自動的にロードする -->
    <key>RunAtLoad</key>
    <false/>

    <!-- プロセスがクラッシュした場合でも再起動しない -->
    <key>KeepAlive</key>
    <false/>

    <!-- 作業ディレクトリ -->
    <key>WorkingDirectory</key>
    <string>REPLACE_WITH_PROJECT_DIR</string>
</dict>
</plist>
